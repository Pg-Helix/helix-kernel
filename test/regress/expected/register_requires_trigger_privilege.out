-- register_source stays PUBLIC-executable, but (ADR-0006 decision 2,
-- helix-atlas) a caller may only register a table it could already attach
-- a trigger to itself. Without that check, any role could use this
-- SECURITY DEFINER function to attach a trigger and a derived view to a
-- table it has no privilege on at all.
CREATE TABLE public.owned_by_other (id bigint PRIMARY KEY, name text);
CREATE ROLE helix_test_registrar NOLOGIN;
GRANT USAGE ON SCHEMA helix_ai TO helix_test_registrar;
SET helix.tenant = 'registrar-tenant';
SET ROLE helix_test_registrar;
-- No privilege whatsoever on owned_by_other: rejected.
SELECT helix_ai.register_source('public', 'owned_by_other', 'embed-v1', 'registrar-rev', 'pipeline-v1');
ERROR:  helix: insufficient privilege on public.owned_by_other to register it (TRIGGER privilege required)
CONTEXT:  PL/pgSQL function register_source(name,name,text,text,text,integer,text) line 43 at RAISE
RESET ROLE;
GRANT TRIGGER ON public.owned_by_other TO helix_test_registrar;
GRANT SELECT, INSERT ON public.owned_by_other TO helix_test_registrar;
GRANT SELECT ON helix_ai.derived_value TO helix_test_registrar;
SET ROLE helix_test_registrar;
-- TRIGGER privilege granted (ownership not required): now allowed.
SELECT helix_ai.register_source('public', 'owned_by_other', 'embed-v1', 'registrar-rev', 'pipeline-v1') IS NOT NULL AS registered;
 registered 
------------
 t
(1 row)

-- The enriched view is actually readable by this same non-owner caller --
-- not just by helix_owner, who created it. Caught once already (the view
-- is a fresh object, private to its creator until granted, regardless of
-- security_invoker) by running this exact registration end to end as a
-- real application role outside pg_regress; this is that gap's regression
-- test. On the merged K3 branch this INSERT also fires the capture
-- trigger, which is exactly why this registration uses its own model
-- revision ('registrar-rev', above) distinct from every k3_*.sql file's
-- 'embed-v1:rev1' -- caught once already too, when the leftover job this
-- INSERT creates made k3_capture_and_claim.sql's "nothing else claimable"
-- assertion fail.
INSERT INTO public.owned_by_other VALUES (1, 'alice');
SELECT id, name FROM public.owned_by_other_ai WHERE id = 1;
 id | name  
----+-------
  1 | alice
(1 row)

RESET ROLE;
REVOKE TRIGGER ON public.owned_by_other FROM helix_test_registrar;
REVOKE SELECT, INSERT ON public.owned_by_other FROM helix_test_registrar;
REVOKE SELECT ON helix_ai.derived_value FROM helix_test_registrar;
REVOKE USAGE ON SCHEMA helix_ai FROM helix_test_registrar;
DROP ROLE helix_test_registrar;
