CREATE TABLE public.k3_items (id bigint PRIMARY KEY, body text);
SET helix.tenant = 'k3-tenant';
SELECT helix_ai.register_source('public', 'k3_items', 'embed-v1', 'rev1', 'pipeline-v1') AS k3_source_id \gset
-- INSERT fired the capture trigger: a pending sidecar row and a job exist
-- already, with no explicit request_refresh call.
INSERT INTO public.k3_items VALUES (1, 'hello');
SELECT status, source_digest IS NOT NULL AS has_digest FROM helix_ai.status WHERE source_id = :k3_source_id;
 status  | has_digest 
---------+------------
 pending | t
(1 row)

SELECT count(*) AS queued_jobs FROM helix_ai.job WHERE source_id = :k3_source_id AND completed_at IS NULL;
 queued_jobs 
-------------
           1
(1 row)

-- claim_job leases exactly that job.
SELECT target_model, pipeline_version, attempts, lease_epoch FROM helix_ai.claim_job();
 target_model  | pipeline_version | attempts | lease_epoch 
---------------+------------------+----------+-------------
 embed-v1:rev1 | pipeline-v1      |        1 |           1
(1 row)

-- A second concurrent claim finds nothing claimable (lease not yet expired).
SELECT helix_ai.claim_job() IS NULL AS nothing_else_claimable;
 nothing_else_claimable 
------------------------
 t
(1 row)

-- request_refresh also enqueues a job, reading the row's current digest itself.
SELECT helix_ai.request_refresh(:k3_source_id, jsonb_build_object('id', '1')) IS NOT NULL AS refresh_enqueued;
 refresh_enqueued 
------------------
 t
(1 row)

SELECT count(*) AS queued_after_refresh FROM helix_ai.job WHERE source_id = :k3_source_id AND completed_at IS NULL;
 queued_after_refresh 
----------------------
                    2
(1 row)

-- Lease it too (rather than publish), so this file leaves no unclaimed job
-- behind for a later test file's claim_job() calls to pick up instead of
-- its own.
SELECT (helix_ai.claim_job()).job_id IS NOT NULL AS refresh_job_claimed;
 refresh_job_claimed 
---------------------
 t
(1 row)

